<Window x:Class="CurePlay.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CurePlay | Smart Game Optimizer" Width="900" Height="680" MinWidth="740" MinHeight="570" Background="{StaticResource Background}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
  </Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,24">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="GAMEPULSE" Foreground="{StaticResource Accent}" FontWeight="Black" FontSize="32"/><TextBlock Text="SMART GAMING OPTIMIZER  /  V1.0" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
      <Border DockPanel.Dock="Right" Background="#1C3A2C" CornerRadius="10" Padding="15,8" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="ModeText" Text="● SMART BOOST ACTIVE" Foreground="{StaticResource Accent}" FontWeight="Bold"/></Border>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CPU LOAD" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CpuText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,6"/><ProgressBar x:Name="CpuBar" Maximum="100" Height="5" Foreground="{StaticResource Accent}" Background="#334155"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="RAM USED" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RamText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,6"/><ProgressBar x:Name="RamBar" Maximum="100" Height="5" Foreground="{StaticResource Accent}" Background="#334155"/></StackPanel></Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="SYSTEM DISK FREE" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DiskText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,6"/><ProgressBar x:Name="DiskBar" Maximum="100" Height="5" Foreground="{StaticResource Accent}" Background="#334155"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="14" Padding="20" Margin="0,0,0,18"><StackPanel>
      <DockPanel><TextBlock Text="SMART BOOST" FontSize="18" FontWeight="Bold"/><CheckBox x:Name="BoostToggle" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Включён" Foreground="{StaticResource Accent}" IsChecked="True" Checked="BoostToggle_Changed" Unchecked="BoostToggle_Changed"/></DockPanel>
      <TextBlock Text="Проверка каждые 5 минут. Очистка только при нехватке места и только вне игры." Foreground="{StaticResource Muted}" Margin="0,10,0,10" TextWrapping="Wrap"/>
      <TextBlock x:Name="GameText" Text="Обнаружение игр: ожидание" Foreground="{StaticResource Accent}" Margin="0,0,0,14"/>
      <StackPanel Orientation="Horizontal"><Button Content="ПРОВЕРИТЬ СЕЙЧАС" Click="CheckNow_Click" Background="#28784C" Margin="0,0,10,0"/><Button Content="НАСТРОИТЬ ИГРЫ" Click="EditGames_Click"/></StackPanel>
    </StackPanel></Border>
    <DockPanel Grid.Row="3" Margin="0,0,0,10"><TextBlock Text="ACTIVITY LOG" FontWeight="Bold" FontSize="17"/><TextBlock x:Name="LastCheckText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" Text="Последняя проверка: —"/></DockPanel>
    <Border Grid.Row="4" Background="{StaticResource Panel}" CornerRadius="14" Padding="14"><ListBox x:Name="LogList" Background="Transparent" Foreground="#D6E4EE" BorderThickness="0" FontFamily="Consolas" FontSize="12"/></Border>
    <DockPanel Grid.Row="5" Margin="0,15,0,0"><TextBlock Text="Без принудительной очистки RAM и вмешательства в игры" Foreground="{StaticResource Muted}" FontSize="11"/><Button Content="СВЕРНУТЬ В ТРЕЙ" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="HideToTray_Click" Padding="12,7"/></DockPanel>
  </Grid>
</Window>
