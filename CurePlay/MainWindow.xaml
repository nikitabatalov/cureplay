<Window x:Class="CurePlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CurePlay 2.1 | Smart Gaming Optimizer"
        Width="1250" Height="850" MinWidth="1060" MinHeight="710" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False" Background="{StaticResource Background}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- Integrated Windows 11-like dark titlebar: native drag/resize remain available -->
    <Border Grid.Row="0" Background="#0B1219" BorderBrush="#25313A" BorderThickness="0,0,0,1">
      <Grid Margin="18,0,10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="26" Height="26" Background="#B4FF78" CornerRadius="8" Margin="0,0,11,0">
            <Viewbox Margin="4"><Path Fill="#101A15" Data="M 8,1 L 4,10 L 9,10 L 7,18 L 17,7 L 11,7 L 13,1 Z"/></Viewbox>
          </Border>
          <TextBlock Text="CUREPLAY" Foreground="{StaticResource TextMain}" FontWeight="Black" FontSize="13" VerticalAlignment="Center"/>
          <TextBlock Text="  /  SYSTEM PERFORMANCE" Foreground="#788E9C" FontSize="10" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="─" Width="42" Height="33" Click="MinimizeWindow_Click" Background="Transparent" Padding="0" FontSize="14"/>
          <Button x:Name="MaximizeButton" Content="□" Width="42" Height="33" Click="MaximizeWindow_Click" Background="Transparent" Padding="0" FontSize="19"/>
          <Button Content="×" Width="42" Height="33" Click="CloseWindow_Click" Background="#43252B" Padding="0" FontSize="22"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#0E1720" BorderBrush="#27333E" BorderThickness="0,0,1,0">
        <DockPanel Margin="18,26,18,19">
          <StackPanel DockPanel.Dock="Top" Margin="8,0,0,30">
            <TextBlock Text="CUREPLAY" Foreground="{StaticResource Accent}" FontWeight="Black" FontSize="29"/>
            <TextBlock Text="GAMING UTILITY  /  2.1" Foreground="#718995" FontSize="10" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Border Background="#172C29" BorderBrush="#2D5746" BorderThickness="1" CornerRadius="11" Padding="12,11" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock x:Name="SideStatus" Text="●  MONITORING ACTIVE" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Developed by Nikita Batalov" Foreground="#9BACB4" FontSize="10" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Button Content="Свернуть в трей   ↙" Click="HideToTray_Click" FontSize="11"/>
          </StackPanel>
          <StackPanel>
            <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Background="#294439" Foreground="#B4FF78" Content="◈     Dashboard" Tag="Dashboard" Click="Navigate_Click"/>
            <Button x:Name="NavNetwork" Style="{StaticResource NavButton}" Content="⌁     CureNet" Tag="Network" Click="Navigate_Click"/>
            <Button x:Name="NavProcesses" Style="{StaticResource NavButton}" Content="▤     Processes" Tag="Processes" Click="Navigate_Click"/>
            <Button x:Name="NavDisks" Style="{StaticResource NavButton}" Content="▣     Disk Health" Tag="Disks" Click="Navigate_Click"/>
            <Button x:Name="NavStutter" Style="{StaticResource NavButton}" Content="⌁     Stutter Lab" Tag="Stutter" Click="Navigate_Click"/>
            <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="⚙     Settings" Tag="Settings" Click="Navigate_Click"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,26,28,32">
          <!-- MAIN DASHBOARD -->
          <StackPanel x:Name="PageDashboard">
            <DockPanel Margin="0,0,0,23">
              <StackPanel><TextBlock Text="Your system. In control." FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Показатели в реальном времени  ·  нажми на карточку, чтобы открыть график" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
            </DockPanel>
            <UniformGrid Columns="4" Margin="0,0,0,16">
              <Button Tag="CPU" Click="OpenMetric_Click" Background="Transparent" Padding="0" Margin="0,0,10,0"><Border Style="{StaticResource Card}" MinHeight="138"><StackPanel>
                <DockPanel><TextBlock Text="CPU  LOAD" Style="{StaticResource Kicker}"/><TextBlock Text="↗" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/></DockPanel>
                <TextBlock x:Name="CpuText" Text="—" FontSize="31" FontWeight="Bold" Margin="0,13,0,12"/>
                <ProgressBar x:Name="CpuBar" Maximum="100"/>
              </StackPanel></Border></Button>
              <Button Tag="GPU" Click="OpenMetric_Click" Background="Transparent" Padding="0" Margin="0,0,10,0"><Border Style="{StaticResource Card}" MinHeight="138"><StackPanel>
                <DockPanel><TextBlock Text="GPU  LOAD" Style="{StaticResource Kicker}"/><TextBlock Text="↗" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/></DockPanel>
                <TextBlock x:Name="GpuText" Text="—" FontSize="31" FontWeight="Bold" Margin="0,13,0,12"/>
                <ProgressBar x:Name="GpuBar" Maximum="100"/>
              </StackPanel></Border></Button>
              <Button Tag="RAM" Click="OpenMetric_Click" Background="Transparent" Padding="0" Margin="0,0,10,0"><Border Style="{StaticResource Card}" MinHeight="138"><StackPanel>
                <DockPanel><TextBlock Text="RAM  USED" Style="{StaticResource Kicker}"/><TextBlock Text="↗" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/></DockPanel>
                <TextBlock x:Name="RamText" Text="—" FontSize="31" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock x:Name="RamSpeedText" Text="Определение..." Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,9"/>
                <ProgressBar x:Name="RamBar" Maximum="100"/>
              </StackPanel></Border></Button>
              <Button Tag="PING" Click="OpenMetric_Click" Background="Transparent" Padding="0"><Border Style="{StaticResource Card}" MinHeight="138"><StackPanel>
                <DockPanel><TextBlock Text="NETWORK  PING" Style="{StaticResource Kicker}"/><TextBlock Text="↗" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/></DockPanel>
                <TextBlock x:Name="PingText" Text="—" FontSize="31" FontWeight="Bold" Margin="0,13,0,5"/>
                <TextBlock x:Name="PingCaption" Text="ICMP • подключение" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
              </StackPanel></Border></Button>
            </UniformGrid>
            <!-- Hero Smart Boost -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="23">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C302B" Offset="0"/><GradientStop Color="#15202A" Offset=".75"/><GradientStop Color="#121B27" Offset="1"/></LinearGradientBrush></Border.Background>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="SMART BOOST  /  ENGINE 01" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/>
                  <TextBlock Text="A little less noise. More game." FontWeight="Bold" FontSize="23" Margin="0,10,0,9"/>
                  <TextBlock Text="Аккуратная проверка каждые 5 минут. Никакого принудительного сброса RAM, отключения защит и изменения процессов игры." TextWrapping="Wrap" Foreground="#AFBDC1" FontSize="12" Margin="0,0,35,14"/>
                  <TextBlock x:Name="GameText" Text="Проверка игр..." Foreground="#B4FF78" FontSize="12" Margin="0,0,0,8"/>
                  <TextBlock x:Name="BoostStateText" Text="Ready · ожидание" Foreground="#A8BDB2" FontSize="12" Margin="0,0,0,12"/>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="BoostModeButton" Content="●  Smart Boost: ON" Style="{StaticResource PrimaryButton}" Click="BoostMode_Click" Margin="0,0,9,0"/>
                    <Button Content="Список игр" Click="EditGames_Click"/>
                  </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" Width="210" Height="210" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Ellipse Width="185" Height="185" Stroke="#3B7658" StrokeThickness="1" Fill="Transparent"/>
                  <Ellipse x:Name="BoostPulseRing" Width="155" Height="155" Stroke="#B4FF78" StrokeThickness="3" Opacity=".15" Fill="Transparent" RenderTransformOrigin=".5,.5">
                    <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                  </Ellipse>
                  <Button x:Name="BoostNowButton" Width="140" Height="140" Click="CheckNow_Click" Style="{StaticResource PrimaryButton}" ToolTip="Проверить систему сейчас">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="core" CornerRadius="76" Background="{TemplateBinding Background}" BorderBrush="#D6FFAA" BorderThickness="2">
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="ϟ" HorizontalAlignment="Center" FontSize="44" Foreground="#0D2117" FontWeight="Black"/>
                        <TextBlock Text="BOOST NOW" HorizontalAlignment="Center" Foreground="#102019" FontWeight="Black" FontSize="12"/></StackPanel>
                    </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="core" Property="Opacity" Value=".82"/></Trigger>
                      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="core" Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                  </Button>
                </Grid>
              </Grid>
            </Border>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel>
                <DockPanel><TextBlock Text="TEMPERATURE GUARD" Style="{StaticResource Kicker}"/><TextBlock Text="◉ LIVE" DockPanel.Dock="Right" Foreground="#B4FF78" FontSize="10"/></DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,13,0,0"><TextBlock x:Name="CpuTempText" Text="CPU —" FontSize="21" FontWeight="SemiBold" Margin="0,0,23,0"/><TextBlock x:Name="GpuTempText" Text="GPU —" FontSize="21" FontWeight="SemiBold"/></StackPanel>
                <TextBlock x:Name="ThermalStatusText" Text="Порог: 93 °C" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
              </StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel>
                <DockPanel><TextBlock Text="SYSTEM DRIVE" Style="{StaticResource Kicker}"/><TextBlock x:Name="DiskStatusText" Text="—" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/></DockPanel>
                <TextBlock x:Name="DiskText" Text="—" FontSize="26" FontWeight="Bold" Margin="0,11,0,11"/>
                <ProgressBar x:Name="DiskBar" Maximum="100"/><TextBlock x:Name="DiskSubText" Text="Свободное место" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/>
              </StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}"><StackPanel>
              <DockPanel Margin="0,0,0,12"><TextBlock Text="ACTIVITY FEED" FontWeight="Bold" FontSize="15"/>
                <TextBlock x:Name="LastCheckText" DockPanel.Dock="Right" HorizontalAlignment="Right" Text="Последняя проверка: —" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel>
              <ListBox x:Name="LogList" Height="115" Background="Transparent" Foreground="#CBDBD5" FontSize="11" FontFamily="Consolas"/>
            </StackPanel></Border>
          </StackPanel>
          <!-- CURENET -->
          <StackPanel x:Name="PageNetwork" Visibility="Collapsed">
            <TextBlock Text="CureNet" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Мониторинг задержки и обрывов · ICMP-узел не обязательно равен игровому серверу" Foreground="{StaticResource Muted}" Margin="0,7,0,22"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel>
              <TextBlock Text="NETWORK PULSE" Style="{StaticResource Kicker}"/>
              <UniformGrid Columns="3" Margin="0,20,0,18">
                <StackPanel><TextBlock Text="PING" Style="{StaticResource Kicker}"/><TextBlock x:Name="NetPingText" Text="—" FontSize="32" FontWeight="Bold"/></StackPanel>
                <StackPanel><TextBlock Text="JITTER" Style="{StaticResource Kicker}"/><TextBlock x:Name="JitterText" Text="—" FontSize="32" FontWeight="Bold"/></StackPanel>
                <StackPanel><TextBlock Text="FAILED PROBES" Style="{StaticResource Kicker}"/><TextBlock x:Name="LossText" Text="—" FontSize="32" FontWeight="Bold"/></StackPanel>
              </UniformGrid>
              <TextBlock x:Name="NetStatusText" Text="Ожидание..." Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
              <DockPanel Margin="0,17,0,0"><TextBlock x:Name="TrafficText" Text="↓ — Mbps  ↑ — Mbps" Foreground="#BDD0D1" FontSize="14"/>
                <Button DockPanel.Dock="Right" Content="PING GRAPH  ↗" Click="OpenPingChart_Click" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"/></DockPanel>
              <TextBlock x:Name="OutageText" Text="Серий неответов: 0" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel>
              <TextBlock Text="CHOOSE TEST TARGET" Style="{StaticResource Kicker}"/>
              <TextBlock Text="Выбери проверочный узел или введи адрес вручную. Региональные хосты принадлежат сторонним провайдерам и могут не отвечать на ICMP." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,14"/>
              <ComboBox x:Name="PingPresetBox" Height="42" SelectionChanged="PingPreset_Changed" Margin="0,0,0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                <TextBox x:Name="PingTargetBox" Grid.Column="0" Text="1.1.1.1" Margin="0,0,11,0" ToolTip="IPv4, IPv6 или доменное имя"/>
                <Button Grid.Column="1" Content="Применить" Style="{StaticResource PrimaryButton}" Click="ApplyPingTarget_Click"/>
              </Grid>
              <TextBlock x:Name="PresetHintText" Text="Если узел не ответил, это может быть ICMP-фильтрация, а не обрыв интернета." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SAFE NETWORK DIAGNOSTICS" FontWeight="Bold" FontSize="16"/>
              <TextBlock Text="CureNet отправляет один небольшой ICMP-запрос раз в 5 секунд и измеряет общую нагрузку интерфейсов. Он не меняет настройки TCP, маршруты или DNS и не обещает снизить задержку до игрового сервера." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel></Border>
          </StackPanel>
          <!-- PROCESSES -->
          <StackPanel x:Name="PageProcesses" Visibility="Collapsed">
            <TextBlock Text="Background Analyzer" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Какие приложения нагружают процессор и память. Закрытие только вручную и с подтверждением." Foreground="{StaticResource Muted}" Margin="0,7,0,21" TextWrapping="Wrap"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <DockPanel Margin="0,0,0,16"><StackPanel><TextBlock Text="RUNNING APPS" Style="{StaticResource Kicker}"/><TextBlock x:Name="ProcessSummaryText" Text="Проверка..." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                <Button DockPanel.Dock="Right" Content="↻  Обновить" Click="RefreshProcesses_Click" HorizontalAlignment="Right"/></DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="Сортировка" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="ProcessSortBox" Width="180" SelectionChanged="ProcessFilter_Changed"><ComboBoxItem Content="По нагрузке" IsSelected="True"/><ComboBoxItem Content="По CPU"/><ComboBoxItem Content="По RAM"/></ComboBox>
                <CheckBox x:Name="OnlyHeavyToggle" Content="Только высокая нагрузка" Margin="22,0,0,0" Checked="ProcessFilter_Changed" Unchecked="ProcessFilter_Changed"/>
              </StackPanel>
              <ItemsControl x:Name="ProcessCards"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="#1B2833" CornerRadius="12" BorderBrush="#30414B" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="96"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Border Background="#2B3A42" CornerRadius="7"/><TextBlock Text="◈" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontSize="20"/>
                      <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Note}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="CPU" Style="{StaticResource Kicker}"/><TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}" FontWeight="Bold" FontSize="14"/></StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="RAM" Style="{StaticResource Kicker}"/><TextBlock Text="{Binding RamMb, StringFormat={}{0:0} MB}" FontWeight="Bold" FontSize="14"/></StackPanel>
                    <Button Grid.Column="4" Content="Закрыть ↗" Tag="{Binding}" Click="CloseProcessCard_Click" VerticalAlignment="Center" Padding="11,9" FontSize="11"/>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="Список отображает только оконные пользовательские программы. Используется запрос на закрытие окна, без Kill() и без системных служб." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,13,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
          </StackPanel>
          <!-- DISKS -->
          <StackPanel x:Name="PageDisks" Visibility="Collapsed">
            <TextBlock Text="Disk Health" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Понятный статус накопителей Windows · нажми «Подробнее», чтобы увидеть доступные данные SMART" Foreground="{StaticResource Muted}" Margin="0,7,0,21"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel>
              <DockPanel Margin="0,0,0,18"><TextBlock Text="STORAGE DEVICES" Style="{StaticResource Kicker}"/><Button Content="↻  Обновить" DockPanel.Dock="Right" Click="RefreshDisks_Click" HorizontalAlignment="Right"/></DockPanel>
              <ItemsControl x:Name="DiskCards"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="#1B2833" CornerRadius="12" BorderThickness="1" BorderBrush="#30414B" Padding="15" Margin="0,0,0,9">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" Background="#283F3B" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock Text="▣" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding KindAndSize}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StatusShort}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Button Grid.Column="3" Content="Подробнее  ↗" Tag="{Binding}" Click="DiskDetails_Click" VerticalAlignment="Center" FontSize="11" Padding="10"/>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
            <Border x:Name="DiskDetailPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
              <DockPanel Margin="0,0,0,12"><TextBlock x:Name="DiskDetailTitle" Text="Диск" FontSize="17" FontWeight="Bold"/>
                <Button DockPanel.Dock="Right" Content="×" Click="HideDiskDetails_Click" HorizontalAlignment="Right" Padding="9,4"/></DockPanel>
              <TextBlock x:Name="DiskDetailStatus" Foreground="{StaticResource Accent}" FontSize="13"/>
              <TextBlock x:Name="DiskDetailTemp" Foreground="#D5E4DF" FontSize="13" Margin="0,11,0,0"/>
              <TextBlock x:Name="DiskDetailMore" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <TextBlock Text="Оценка Windows «Здоров» не исключает SMART-ошибок. Если данных нет, CurePlay не сообщает, что накопитель исправен." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="8,15,0,0"/>
          </StackPanel>
          <!-- STUTTER LAB -->
          <StackPanel x:Name="PageStutter" Visibility="Collapsed">
            <TextBlock Text="Stutter Lab" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Два режима: автоматический поиск системных перегрузок и точный анализ кадров из PresentMon" Foreground="{StaticResource Muted}" Margin="0,7,0,20" TextWrapping="Wrap"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel>
              <TextBlock Text="AUTO SYSTEM HITCH WATCH" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="HitchStatusText" Text="Ожидание измерений" FontWeight="Bold" FontSize="20" Margin="0,12,0,10"/>
              <TextBlock x:Name="HitchCountText" Text="Событий: 0" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
              <TextBlock Text="Ищет высокую нагрузку CPU / RAM, GPU и сильные скачки пинга во время запущенной игры. Не измеряет реальный frametime: событие нагрузки не доказывает микрофриз." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="REAL FRAME-TIME  /  ADVANCED" Style="{StaticResource Kicker}"/>
              <TextBlock Text="Для настоящих FPS, 1% Low и времени кадра можно записать сессию в Intel PresentMon. Потом импортировать CSV — CurePlay всё посчитает." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,14"/>
              <WrapPanel><Button Content="↓  Скачать PresentMon" Click="OpenPresentMon_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/>
                <Button Content="Импорт CSV" Click="ImportFrames_Click" Margin="0,0,10,10"/></WrapPanel>
              <TextBlock x:Name="StutterResultText" Text="Записи кадров ещё нет." FontSize="14" Foreground="#CBDED8" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel></Border>
          </StackPanel>
          <!-- SETTINGS -->
          <StackPanel x:Name="PageSettings" Visibility="Collapsed">
            <TextBlock Text="Settings" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Приватные локальные настройки · никакого принудительного разгона или изменения реестра" Foreground="{StaticResource Muted}" Margin="0,7,0,20"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel>
              <TextBlock Text="RAM DIAGNOSTICS" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="RamDiagnosticText" Text="Определение конфигурации модулей..." Foreground="#D7E9DD" FontSize="14" TextWrapping="Wrap" Margin="0,13,0,8"/>
              <TextBlock Text="Сравнение скоростей SMBIOS не является проверкой XMP/EXPO и не гарантирует безопасный разгон. CurePlay ничего не меняет в BIOS." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel>
              <TextBlock Text="TEMPERATURE GUARD" Style="{StaticResource Kicker}"/>
              <CheckBox x:Name="ThermalAlertsToggle" Content="Звуковое предупреждение о высокой температуре" IsChecked="True" Checked="ThermalSettings_Changed" Unchecked="ThermalSettings_Changed" Margin="0,17,0,0"/>
              <DockPanel Margin="0,18,0,8"><TextBlock Text="Порог CPU / GPU"/><TextBlock x:Name="ThresholdText" Text="93 °C" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="Bold"/></DockPanel>
              <Slider x:Name="TemperatureSlider" Minimum="60" Maximum="110" Value="93" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ThermalSettings_Changed"/>
              <TextBlock Text="Начальный порог 93 °C — только уведомление, а не норматив для каждого процессора или видеокарты. Повтор сигнала раз в 2 минуты." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,15"><StackPanel>
              <TextBlock Text="NETWORK MONITOR" Style="{StaticResource Kicker}"/>
              <CheckBox x:Name="NetEnabledToggle" Content="Фоновая проверка ICMP каждые 5 секунд" IsChecked="True" Checked="NetworkSettings_Changed" Unchecked="NetworkSettings_Changed" Margin="0,17,0,0"/>
              <TextBlock Text="Возможна фильтрация ICMP. Приложение не отправляет статистику разработчику." Foreground="{StaticResource Muted}" Margin="0,11,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ABOUT CUREPLAY" Style="{StaticResource Kicker}"/>
              <TextBlock Text="CurePlay 2.1  ·  Developed by Nikita Batalov" FontWeight="SemiBold" FontSize="15" Margin="0,11,0,8"/>
              <TextBlock Text="Локальный мониторинг и аккуратные проверки. Без обещаний прироста FPS, RAM-тримминга, скрытого закрытия приложений и вмешательства в античит." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
