<Application x:Class="CurePlay.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Background" Color="#090E14"/>
    <SolidColorBrush x:Key="Panel" Color="#151D28"/>
    <SolidColorBrush x:Key="PanelHover" Color="#1D2A33"/>
    <SolidColorBrush x:Key="Accent" Color="#B4FF78"/>
    <SolidColorBrush x:Key="Muted" Color="#8FA1AF"/>
    <SolidColorBrush x:Key="Stroke" Color="#2B3944"/>
    <SolidColorBrush x:Key="TextMain" Color="#EDF6F5"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="19"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#263540"/>
      <Setter Property="Foreground" Value="#EFF7F3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="17,11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}" BorderBrush="#2C4145" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.77"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.60"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.34"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#A3EF71"/>
      <Setter Property="Foreground" Value="#0C1512"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="17,14"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#A4B5BC"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="Kicker" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#EAF3F0"/><Setter Property="Background" Value="#202E37"/>
      <Setter Property="BorderBrush" Value="#38505A"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#EAF3F0"/><Setter Property="Background" Value="#202E37"/>
      <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF3F0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Background" Value="#304048"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="5"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D9E8E3"/><Setter Property="BorderThickness" Value="0"/></Style>
  </Application.Resources>
</Application>
